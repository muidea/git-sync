[Unit]
Description=GitHub Repository Mirror Backup
After=network-online.target
Wants=network-online.target
OnFailure=git-backup-emergency-notify.service

[Service]
Type=oneshot
EnvironmentFile=/etc/git-backup/secret.env
ExecStart=/usr/local/bin/git-backup sync --config /etc/git-backup/config.yaml
SuccessExitStatus=0 2
IOSchedulingClass=best-effort
Nice=10

[Install]
WantedBy=multi-user.target
