# GitHub Fine-grained PAT（需授予目标仓库 Metadata: Read-only 与 Contents: Read-only）
GITHUB_BACKUP_TOKEN=github_pat_replace_me

# 若开启 git-backup serve 且绑定非回环地址，必须设置管理接口 Token
# BACKUP_API_TOKEN=change_me_to_strong_random_token

# 可选：Webhook 告警地址与加签密钥（飞书/钉钉）
# BACKUP_ALERT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# BACKUP_ALERT_SECRET=

# 可选：每周一 09:00 推送健康度周报
# WEEKLY_REPORT_CRON=0 9 * * 1
